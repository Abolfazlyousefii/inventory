APP_NAME="نرم افزار داخلی آریا گستر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=ariya_inventory_session_v2
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production ERP values (do not use a shared parent-domain cookie):
# APP_URL=https://inv.ariyajanebi.ir
# SESSION_COOKIE=ariya_inventory_session_v2
# SESSION_DOMAIN=inv.ariyajanebi.ir
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=10.0.0.10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

EXTERNAL_SYNC_BASE_URL=https://crm.ariyajanebi.ir
EXTERNAL_SYNC_TOKEN=
# The sales website must send this token as Bearer and/or X-CRM-Token.
# Inventory endpoints:
# POST /api/external/users
# POST /api/external/orders

CRM_SYNC_ENABLED=false
CRM_BASE_URL=https://crm.ariyajanebi.ir
CRM_USERS_ENDPOINT=/api/integrations/erp/users
CRM_SYNC_TOKEN=
CRM_SYNC_LIMIT=100
CRM_SYNC_OVERLAP_SECONDS=120
CRM_USERS_CHANGES_URL=https://crm.ariyajanebi.ir/api/integrations/erp/users/changes
CRM_CUSTOMERS_ENDPOINT=/external/customers
CRM_CUSTOMER_ENDPOINT_TEMPLATE=
CRM_API_TOKEN=
CRM_SYNC_TIMEOUT=30
CRM_CONNECT_TIMEOUT=10
CRM_SYNC_VERIFY_SSL=true
CRM_SYNC_INTERVAL_MINUTES=15
CRM_SYNC_MISSING_USERS_STRATEGY=deactivate
CRM_USERS_SYNC_BATCH_SIZE=100
CRM_USERS_SYNC_MAX_PAGES=1000
CRM_ALLOW_INITIAL_PHONE_LINK=false
CRM_SYNC_MISSING_CUSTOMERS_STRATEGY=delete
CRM_CUSTOMER_PUSH_BATCH_SIZE=100
CRM_SSO_ENABLED=false
CRM_LOCAL_LOGIN_FOR_MANAGED_USERS=true
CRM_OAUTH_CLIENT_ID=
CRM_OAUTH_CLIENT_SECRET=
CRM_OAUTH_REDIRECT_URI=https://inv.ariyajanebi.ir/auth/crm/callback
CRM_OAUTH_AUTHORIZE_URL=https://crm.ariyajanebi.ir/oauth/authorize
CRM_OAUTH_TOKEN_URL=https://crm.ariyajanebi.ir/oauth/token
CRM_OAUTH_USER_URL=https://crm.ariyajanebi.ir/api/integrations/erp/me
CRM_OAUTH_SCOPE=erp.user.read
CRM_OAUTH_PKCE_ENABLED=true
SALES_SERVER_API_URL=
SALES_SERVER_API_TOKEN=
SALES_SERVER_SYNC_ENABLED=false
