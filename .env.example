APP_NAME="نرم افزار داخلی آریا گستر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=inventory_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# CRM database connection (config/database.php -> connections.CRM).
# These are REQUIRED: since the 2e9c121 merge the CRM connection no longer falls
# back to the DB_* values, so leaving them unset makes every CRM lookup
# (for example phone-token login) fail with a PDO "Access denied" error.
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=3306
CRM_DB_DATABASE=
CRM_DB_USERNAME=
CRM_DB_PASSWORD=
